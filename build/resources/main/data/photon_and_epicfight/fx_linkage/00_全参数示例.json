{
  // ============================================================
  // Photon + EpicFight 特效联动数据包 —— 全参数中文说明
  // 文件路径: data/<modid>/fx_linkage/任意名字.json
  // 注意: JSON 标准不支持注释，下面这些中文说明只是为了演示
  //       实际使用前务必删掉所有 // 开头的注释行
  // ============================================================

  "type": "epicfight_fx:linkage",
  // ↑ 固定值，告诉系统这是个特效联动配置，不要改


  // ======================== 基础信息 ========================

  "priority": 10,
  // ↑ 优先级，数字越大越优先匹配
  //   同一事件有多个 linkage 匹配时，优先执行高优先级的
  //   范围: 0 ~ 100，默认 10


  "side": "both",
  // ↑ 运行端，可选:
  //   "both"    → 客户端 + 服务端都执行（默认）
  //   "client"  → 只在客户端执行（特效、音效、镜头震动）
  //   "server"  → 只在服务端执行（伤害、命令）


  // ======================== 武器匹配 ========================

  "weapon_categories": [
    // ↑ 匹配 EpicFight 武器类型（列表，满足一个就算匹配）
    "epicfight:katana",      // 太刀
    "epicfight:sword",       // 剑
    "epicfight:greatsword",  // 大剑
    "epicfight:dagger",      // 匕首
    "epicfight:spear"        // 矛
  ],

  "weapons": [
    // ↑ 匹配具体物品 ID（列表，满足一个就算匹配）
    //   和 weapon_categories 是 "或" 的关系
    "minecraft:diamond_sword"
  ],

  "skills": [
    // ↑ 匹配技能 ID（列表，满足一个就算匹配）
    //   留空或删掉 = 不限制技能
    "epicfight:katana_autoguard"
  ],

  "hand": "mainhand",
  // ↑ 手部限制（仅文档标记，当前未在匹配逻辑中强制执行，留空即可）
  //   可选: "mainhand" / "offhand"


  // ======================== 条件系统 ========================

  "conditions": [
    // ↑ 全局条件列表，所有条件都满足才执行这个 linkage
    //   这里的是"是否匹配这个 linkage"
    //   events 里的是"是否执行这个 event"

    // --- 数值比较 ---
    { "type": "phase", "min": 0, "max": 3 },
    { "type": "combo", "min": 1, "max": 999 },
    { "type": "distance", "min": 0, "max": 5 },

    // --- 血量判断 ---
    {
      "type": "health",
      "target": "target",
      // ↑ "self" = 攻击者自己, "target" = 目标
      "min": 0,
      "max": 0.3,
      "comparator": "less_ratio"
      // ↑ 比较器: greater_ratio / less_ratio / greater_ratio_contain / less_ratio_contain
      //   不写 = 用 min/max 范围匹配
    },

    // --- 类型判断 ---
    { "type": "weapon_category", "value": "epicfight:katana" },
    { "type": "weapon_id", "value": "minecraft:diamond_sword" },
    { "type": "skill", "value": "epicfight:katana_autoguard" },
    { "type": "hit_type", "value": "critical" },
    //   hit_type 可选: "normal" 或 "critical"

    { "type": "target_type", "value": "boss" },
    //   target_type 可选: "living" / "player" / "boss"

    { "type": "target_state", "value": "guarding" },
    //   target_state 可选:
    //   "guarding"  → 格挡中（GuardSkill.isActivated）
    //   "stunned"   → 眩晕（EntityState.hurt > 0）
    //   "knockdown" → 击倒（EntityState.knockDown）
    //   "airborne"  → 滞空（LivingEntityPatch.isAirborneState，非玩家目标也可用）

    { "type": "entity_tag", "value": "minecraft:skeletons" },
    // ↑ 目标实体标签（EntityType tag），如 minecraft:skeletons / minecraft:raiders

    { "type": "biome", "value": "minecraft:plains" },
    // ↑ 生物群系，如 minecraft:plains / minecraft:nether_wastes

    { "type": "weather", "value": "rain" },
    // ↑ 天气，可选: "clear" / "rain" / "thunder"

    { "type": "moon_phase", "value": "0" },
    // ↑ 月相（0-7），0=满月

    { "type": "enchantment", "value": "minecraft:sharpness" },
    // ↑ 武器附魔检测，需安装指定附魔

    { "type": "potion_effect", "value": "minecraft:strength" },
    // ↑ 攻击者身上的药水效果

    { "type": "has_counter", "min": 0, "max": 3 },
    // ↑ 阶段计数器（对应 states.phase）

    { "type": "animation_phase", "value": "2" },
    // ↑ EpicFight 动画阶段: 1=蓄力, 2=攻击中, 3=收招

    { "type": "world_time", "min": 0.5, "max": 0.75 },
    // ↑ 世界时间（0-1 比例），0.5=中午, 0.75=傍晚

    { "type": "random", "value": "0.5" },
    // ↑ 概率触发，0.5 = 50% 概率

    // --- 逻辑组合 ---
    { "all_of": [
      // ↑ 里面的条件必须全部满足（AND）
      { "type": "weapon_category", "value": "epicfight:katana" },
      { "type": "hit_type", "value": "critical" }
    ]},
    { "any_of": [
      // ↑ 里面的条件满足任意一个即可（OR）
      { "type": "combo", "min": 5 },
      { "type": "health", "target": "target", "max": 0.2, "comparator": "less_ratio" }
    ]},
    { "none_of": [
      // ↑ 里面的条件必须全部不满足（NOT）
      { "type": "target_state", "value": "guarding" }
    ]}
  ],


  // ======================== 阶段与冷却 ========================

  "states": {
    "phaselock": false,
    // ↑ 是否锁定阶段

    "phase": 0,
    // ↑ 初始阶段数

    "max_phase": 3,
    // ↑ 最大阶段数

    "cooldown": 5
    // ↑ 冷却时间（tick，20 tick = 1 秒）
  },


  // ======================== 可用事件说明 ========================

  // ✅ 当前所有事件均可触发:

  // 攻击视角（你攻击别人时触发）:
  //   on_hit           命中目标（LivingHurtEvent / DEAL_DAMAGE_EVENT）
  //   on_first_hit     首次命中（hit 计数器，同一次战斗中仅一次）
  //   on_blocked       攻击被目标格挡（目标 GuardSkill 激活中）

  // 防守视角（你被攻击时触发）:
  //   on_guard         成功格挡（你格挡了对方的攻击 → BLOCKED）
  //   on_parry         成功招架（你招架了对方的攻击 → parried）
  //   on_dodge         成功闪避（DODGE_SUCCESS_EVENT）

  // 通用视角:
  //   on_skill_start   技能开始（SKILL_CAST_EVENT）
  //   on_skill_end     技能结束（SKILL_CANCEL_EVENT / ATTACK_ANIMATION_END）
  //   on_combo         连击变化（COMBO_COUNTER_HANDLE_EVENT）
  //   on_stun          造成眩晕（EntityStunEvent，不含 KNOCKDOWN）
  //   on_knockdown     击倒目标（EntityStunEvent + KNOCKDOWN）
  //   on_charged       蓄力完成（SKILL_CAST_EVENT + 蓄力量检测）
  //   on_airborne      滞空状态（ANIMATION_BEGIN + jump/fly/fall）
  //   on_phase_change  动画阶段变化（ANIMATION_BEGIN / ATTACK_PHASE_END）
  //   on_kill          击杀目标（PLAYER_KILLED_EVENT）
  //   on_execution     处决触发（需安装 CombatEvolution）

  // 注: 所有事件已在代码中实现，不需要 Mixin 或额外配置


  // ======================== 特效事件配置 ========================

  // ✅ 当前可用的核心事件
  // 注: 以下 on_hit / on_skill_start 等是配置示例
  //     用 events 数组可以放任何可用的 trigger

  // 技能开始时触发
  "on_skill_start": {
    "trigger": "on_skill_start",
    "fx": "photon:fire",
    // ↑ fx 路径 = ResourceLocation（命名空间:路径）
    //   对应加载: assets/<命名空间>/fx/<路径>.fx
    //
    //   photon:fire → assets/photon/fx/fire.fx
    //   photon:orb  → assets/photon/fx/orb.fx
    //
    //   注意: Photon 自身不附带任何 .fx 文件！
    //        这些 .fx 文件需要由其他 mod 或资源包提供。
    //   你的项目在运行时可能有 LDlib 的演示特效:
    //   fire / fire_bloom / new_fire / orb / orb_bloom
    //   trail / portal / test / matrix / waterfall
    //   color_tail / fancy_line / fancy_line2 / fire_opaque
    //   trail_shader / trail_shader2 / aaaaa
    //
    //   如果要自定义特效:
    //   1. 在 assets/<你的modid>/fx/ 下创建 .fx 文件
    //   2. 引用方式: <你的modid>:<文件名>（不含 .fx）
    //   例: assets/photon_and_epicfight/fx/myfx.fx
    //      → photon_and_epicfight:myfx
    "position": "weapon",
    // ↑ 特效位置: target / weapon / self / ground

    "follow": true,
    // ↑ 是否跟随实体移动

    "bone": "Tool_R",
    // ↑ 绑定到指定骨骼（可选）
    //   当 follow=true 时，特效会跟随实体并定位到该骨骼位置
    //   当 follow=false 时，在骨骼位置生成一个固定特效
    //   常用骨骼名（HumanoidArmature）:
    //   "Tool_R" / "Tool_L"  → 武器（右/左手）
    //   "Hand_R" / "Hand_L"  → 手
    //   "Head"               → 头
    //   "Chest"              → 胸
    //   非玩家实体有不同的骨骼结构，请参考各 Armature 实现

    "follow_rotation": true,
    // ↑ 特效是否跟随实体/骨骼旋转（可选）
    //   true / "forward"  → 跟随实体前进方向
    //   "look"            → 跟随实体视角方向
    //   "xrot"            → 跟随实体 X 轴旋转
    //   false / "none"    → 不跟随旋转
    //   当绑定 bone 时，推荐启用（bone 位置 + 旋转跟随效果最佳）

    "allow_multi": false,
    // ↑ 是否允许同名特效叠加（可选，默认 false）
    //   false → 每次触发前先停止之前的同名特效，再重新播放（保证重新触发生效）
    //   true  → 不停止旧特效，新旧特效同时叠加播放
    //   建议保持 false，除非你明确需要多重特效叠加

    "duration": 20
    // ↑ 持续 tick 数
  },

  // 命中触发（所有武器、所有实体通用）
  "on_hit": [
    {
      "trigger": "on_hit",
      "fx": "photon:orb_bloom",
      "position": "target",
      "scale": 1.5,
      "conditions": [
        { "type": "hit_type", "value": "critical" }
      ],
      "commands": [
        { "type": "play_sound", "sound": "minecraft:entity.player.attack.crit", "volume": 1.0, "pitch": 1.3 }
      ]
    },
    {
      "trigger": "on_hit",
      "fx": "photon:fire",
      "position": "target",
      "conditions": [
        { "type": "hit_type", "value": "normal" }
      ]
    }
  ],

  // events 通用数组（可以放任何 trigger）
  "events": [
    {
      "trigger": "on_hit",
      "fx": "photon:color_tail",
      "position": "target",
      "follow": true,
      "conditions": [
        { "type": "combo", "min": 3 }
      ]
    }
  ]
}
