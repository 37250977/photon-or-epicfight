{
  // ============================================================
  // Photon + EpicFight 特效配置档 —— 全参数中文说明
  // 文件路径: data/<modid>/fx_profiles/任意名字.json
  // 功能: 定义可复用的特效模板，供 fx_linkage 引用
  // 注意: JSON 标准不支持注释，实际使用前务必删掉所有 // 开头的注释行
  // ============================================================

  "type": "epicfight_fx:profile",
  // ↑ 固定值，告诉系统这是个特效配置档，不要改


  // ======================== 基本信息 ========================

  "name": "my_profile",
  // ↑ 配置档名称，必填，在 fx_linkage 的 events 中通过 profile 字段引用
  //   例如: { "trigger": "on_hit", "profile": "my_profile" }
  //   引用后，该 effect 的 fx/position/follow/scale/duration/inherit_color
  //   等属性会自动继承自这个配置档


  "fx": "photon:fire",
  // ↑ 默认特效文件路径，ResourceLocation 格式
  //
  //   ResourceLocation = 命名空间:路径
  //   对应加载: assets/<命名空间>/fx/<路径>.fx
  //
  //   photon:fire → assets/photon/fx/fire.fx
  //
  //   注意: Photon 自身不附带 .fx 文件，需要由其他 mod 或资源包提供
  //   你的项目在运行时可能有 LDlib 的演示特效:
  //   fire / fire_bloom / new_fire / orb / orb_bloom
  //   trail / portal / test / matrix / waterfall 等
  //
  //   自定义特效: assets/<你的modid>/fx/<文件名>.fx
  //             引用时写 <你的modid>:<文件名>
  //
  //   当 fx_linkage 中的 effect 没有显式指定 fx 时，使用此值
  //   如果 linkage 的 effect 也写了 fx，以 linkage 的为准（覆盖）


  "position": "target",
  // ↑ 默认特效生成位置:
  //   "weapon"  → 武器位置（推荐）
  //   "self"    → 攻击者自身位置
  //   "target"  → 目标位置
  //   "ground"  → 地面


  "follow": false,
  // ↑ 默认是否跟随目标移动
  //   true  → 跟随（适用于持续特效）
  //   false → 固定位置（适用于爆发特效）


  "bone": "Tool_R",
  // ↑ 默认绑定骨骼（可选）
  //   在 fx_linkage 中引用此 profile 后，bone 也可被 linkage 中的 effect 覆盖


  "follow_rotation": false,
  // ↑ 默认是否跟随旋转（可选）
  //   true / "forward"  → 跟随前进方向
  //   "look"            → 跟随视角方向
  //   "xrot"            → 跟随 X 轴旋转
  //   false / "none"    → 不跟随
  //   可被 linkage 中的 effect 覆盖


  "allow_multi": false,
  // ↑ 是否允许同名特效叠加（可选，默认 false）
  //   false → 每次触发前先停止之前的同名特效，再重新播放（保证重新触发生效）
  //   true  → 不停止旧特效，新旧特效同时叠加播放
  //   可被 linkage 中的 effect 覆盖


  "scale": 1.0,
  // ↑ 默认特效大小倍率，1.0 = 原始大小


  "duration": 0,
  // ↑ 默认特效持续时间（tick，0 = 只播放一次）


  "inherit_color": false,
  // ↑ 默认是否继承武器附魔颜色


  "conditions": [
    // ↑ 默认条件列表（可选）
    //   当 fx_linkage 引用此 profile 时，这些条件也会被检查
    //   只有条件满足时才使用此 profile 的默认值
    //   如果 linkage 的 effect 也有 conditions，两套条件是 AND 关系
    { "type": "weapon_category", "value": "epicfight:katana" }
  ],


  "commands": [
    // ↑ 默认指令列表（可选）
    //   当 fx_linkage 引用此 profile 时，这些指令也会被执行
    //   和 linkage effect 的 commands 合并执行
    {
      "type": "play_sound",
      "sound": "minecraft:entity.player.attack.crit",
      "volume": 0.8,
      "pitch": 1.2
    }
  ],


  // ======================== 条件覆盖 ========================

  "overrides": {
    // ↑ 条件覆盖配置
    //   键名: 覆盖场景名称（自定义，见下面说明）
    //   值:   FxEffect 对象，覆盖或扩展此 profile 的默认行为
    //
    //   场景名称可以是任意自定义字符串，由编写者自己定义含义
    //   常用的覆盖场景:
    //
    //   "on_critical"      → 暴击时使用这个覆盖
    //   "on_guard_break"   → 破防时使用这个覆盖
    //   "on_armor_break"   → 穿甲时使用
    //   "on_long_combo"    → 高连击时使用
    //   "on_low_health"    → 目标低血量时
    //   "on_night"         → 夜晚时
    //   "on_nether"        → 下界时
    //   实际上不限制名字，任何字符串都可以，由 fx_linkage 的 conditions 决定何时匹配
    //
    //   每个 override 的字段说明见下:

    "on_critical": {
      // ↑ 覆盖场景名，与 linkage 中 conditions 配合使用
      //   当 linkage 的 effect 配置了 profile 引用 + conditions 时，
      //   如果 conditions 匹配，且 overrides 中有对应场景名，
      //   则使用 override 里的属性替换 profile 默认值

      "trigger": "on_hit",
      // ↑ 触发事件 (同 FxEffect)

      "fx": "photon:new_fire",
      // ↑ 覆盖: 暴击时使用这个特效代替默认的 photon:fire

      "position": "target",
      // ↑ 覆盖位置

      "follow": false,
      // ↑ 覆盖跟随

      "scale": 1.5,
      // ↑ 覆盖大小倍率

      "duration": 10,
      // ↑ 覆盖持续时间

      "inherit_color": true,
      // ↑ 覆盖继承颜色

      "conditions": [
        // ↑ 覆盖专用的额外条件（可选）
        //   必须满足此条件才会使用这个 override
        { "type": "hit_type", "value": "critical" }
      ],

      "commands": [
        // ↑ 覆盖专用指令（可选）
        //   如果写了 commands，会替换 profile 默认的 commands
        //   如果想追加而不是替换，可以在 linkage 的 effect 里写 commands
        {
          "type": "play_sound",
          "sound": "minecraft:entity.lightning_bolt.impact",
          "volume": 1.0,
          "pitch": 0.8
        }
      ]
    },

    "on_guard_break": {
      "trigger": "on_hit",
      "fx": "photon:orb_bloom",
      "scale": 2.0
    },

    "on_night": {
      "trigger": "on_hit",
      "fx": "photon:fire_bloom",
      "inherit_color": true,
      "conditions": [
        { "type": "world_time", "min": 0.75 }
      ]
    }
  }
}
